# ACTA Backend configuration template — copy to .env locally; do not commit .env
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=openrouter/free

# Required for live audio transcription (choose Groq or OpenAI)
ACTA_TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Frontend deployment URL and comma-separated allowed browser origins
ACTA_FRONTEND_URL=https://YOUR-ACTA-FRONTEND-DOMAIN
ACTA_CORS_ORIGINS=https://YOUR-ACTA-FRONTEND-DOMAIN

# Public integration credentials (configured only on the backend)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
ACTA_CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET

GOOGLE_CALENDAR_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CALENDAR_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_CALENDAR_REDIRECT_URI=https://YOUR-ACTA-BACKEND-DOMAIN/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_ID=primary

ACTA_DEMO_SESSION_HOURS=24
ACTA_DEMO_RATE_LIMIT_PER_HOUR=20
APP_ENV=production
