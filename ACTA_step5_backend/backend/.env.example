# Required backend credentials (never put these in frontend files or GitHub)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=openrouter/free
APP_ENV=development

# Telegram task notifications
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Google Calendar OAuth (create a Web application OAuth client)
GOOGLE_CALENDAR_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CALENDAR_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_ID=primary
ACTA_FRONTEND_URL=http://localhost:5173

# Optional speech-to-text provider. Select Groq OR OpenAI.
ACTA_TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY
# Alternative:
# ACTA_TRANSCRIPTION_PROVIDER=openai
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
